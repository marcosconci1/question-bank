vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 300
  }
}

title: "Curation: the agent reviews, Marcos sees exceptions only"

capture: "CAPTURE | importer writes candidate questions" {
  shape: parallelogram
}

audit: "AGENT AUDIT (automated) | 1. fields match the schema | 2. format right (options, answer key range) | 3. content sanity heuristics | 4. tags registered" {
  style.fill: "#e8f0fe"
}

clean: "format-clean -> ACTIVE in bulk per year" {
  shape: cylinder
}

flagged: "heuristic-flagged -> SUSPENDED + reason" {
  shape: parallelogram
  style.fill: "#fdf2d0"
}

close: "closer pass by the agent | fix or void" {
  shape: hexagon
}

marcos: "Marcos | exceptions report only" {
  shape: person
}

capture -> audit
audit -> clean: "passed"
audit -> flagged: "suspicious"
flagged -> close
close -> clean: "fixed"
close -> marcos: "unfixable"
