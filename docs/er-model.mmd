        string slug PK
        string name
        string level
    }
    STUDY_SESSION {
        string id PK
        date date
        string filter
    }
    ANSWER {
        string id PK
        string session_id FK
        string question_id FK
        string given_answer
        bool is_correct
        int time_spent
    }
