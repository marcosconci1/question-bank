flowchart LR
    subgraph SOURCES["Official sources"]
        P1["POSCOMP dataset<br/>(peer-reviewed CSV)"]
        P2["ENADE dataset<br/>(Mendeley, 2005-2021)"]
        P3["INEP PDFs<br/>(gaps)"]
    end

    subgraph FETCH["Fetchers (ours, dumb)"]
        F1["fetch-poscomp"]
        F2["fetch-enade"]
    end

    subgraph PARSE["Parsers (borrowed)"]
        E1["dataset as-is<br/>(no parser needed)"]
        E2["MinerU / Docling<br/>ENEM parser fallback"]
    end

    subgraph NORMALIZE["Normalizers (ours)"]
        A1["adapters/poscomp.py"]
        A2["adapters/enade.py"]
    end

    VAL["Shared validator<br/>(schema + tags + ranges)"]

    subgraph BANK["The bank (committed, content only)"]
        Q["questions/*.json<br/>status: candidate | active |<br/>suspended | voided"]
        CTX["contexts/*.json"]
        ASSETS["assets/<br/>images"]
        TAGS["docs/tags.md"]
        CORR["corrections/ overlay"]
    end

    subgraph RUNTIME["Runtime (not bank content)"]
        SESS["session files"]
        ALOG["data/answers.jsonl"]
    end

    subgraph CONSUME["Consumers"]
        RUN["CLI quiz runner"]
        STATS["stats aggregator"]
    end

    P1 --> F1 --> E1 --> A1
    P2 --> F2 --> E2 --> A2
    P3 --> F2
    A1 --> VAL
    A2 --> VAL
    CORR --> Q
    VAL --> Q
    VAL --> CTX
    VAL --> ASSETS
    Q --> RUN
    CTX --> RUN
    ASSETS --> RUN
    TAGS --> RUN
    RUN --> SESS
    RUN --> ALOG
    ALOG --> STATS
    STATS -. "next session filter" .-> RUN

    style BANK fill:#16213e,stroke:#7c3aed,color:#e0e0e0
    style RUNTIME fill:#1a1a2e,stroke:#38bdf8,color:#e0e0e0
